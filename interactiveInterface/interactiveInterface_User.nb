Cell[BoxData[
 RowBox[{
  RowBox[{"requiredPackages", "=", 
   RowBox[{"{", 
    RowBox[{"\"\<common`routines`\>\"", ",", "\"\<common`pointMarkers`\>\"", 
     ",", "\"\<myConstants`common`\>\"", ",", "\"\<myConstants`lists`\>\"", 
